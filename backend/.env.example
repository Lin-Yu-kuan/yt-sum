# 請前往 Google AI Studio (https://aistudio.google.com/) 申請免費 API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 可選：指定 Gemini 模型（預設 gemini-3.5-flash-lite）
GEMINI_MODEL=gemini-3.5-flash-lite

# 可選：當 YouTube 要求登入驗證（bot check）時，提供 yt-dlp 使用的 Cookies
# 也可直接將匯出的 cookies.txt 放在 backend/cookies.txt 或 ~/.yt-sum/cookies.txt
# YOUTUBE_COOKIES_FILE=D:\path\to\cookies.txt
# YOUTUBE_COOKIES_FROM_BROWSER=chrome
